<Window x:Class="SkyrimAutoDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skyrim AE - AI &amp; Offline Diagnostics, Solution Finder &amp; Auto-Patcher"
        Icon="pack://application:,,,/app.ico"
        Height="950" Width="1350"
        MinHeight="890" MinWidth="1200"
        Background="#181A1F" Foreground="#E6E6E6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dunkler Button-Style mit automatischem Zeilenumbruch -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2A2E37"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderBrush" Value="#3E4452"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#61AFEF"/>
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Runder Mini-Auge-Button-Style (statisch, nicht animiert) für das Minispiel -->
        <Style TargetType="Button" x:Key="MiniEyeButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Ellipse x:Name="MiniEyeRing"
                                     Stroke="#3B82F6"
                                     StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#61AFEF" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
                                </Ellipse.Effect>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Logo.png"
                                                Viewbox="0.295, 0.03, 0.41, 0.61"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniEyeRing" Property="Stroke" Value="#E5C07B"/>
                                <Setter TargetName="MiniEyeRing" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="MiniEyeRing" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E5C07B" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniEyeRing" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="DarkTextBox">
            <Setter Property="Background" Value="#181A1F"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3E4452"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dunkles TabItem-Design: Unterstützt individuelle Hintergrund-/Rahmen-/Textfarben -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DCDFE4"/>
            <Setter Property="Background" Value="#181A1F"/>
            <Setter Property="BorderBrush" Value="#3E4452"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="14,8"
                                Margin="0,0,6,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#282C34"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A3241"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5,2,1.5,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eigenes TabControl-Layout, damit die Tab-Leiste 100 % der Breite nutzt und DockPanel.Dock="Right" greift -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       IsItemsHost="True"
                                       LastChildFill="False"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,0"/>

                            <Border Grid.Row="1"
                                    Background="#21252B"
                                    BorderBrush="#3E4452"
                                    BorderThickness="1"
                                    CornerRadius="0,6,6,6"
                                    Padding="12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER MIT ANGEPASSTEM HINTERGRUNDBILD AUS LOGO.PNG -->
        <Border Grid.Row="0" CornerRadius="6" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
            <Border.Background>
                <ImageBrush x:Name="HeaderBgBrush"
                            ImageSource="pack://application:,,,/Logo.png"
                            Viewbox="0.0, 0.10, 1.0, 0.36"
                            ViewboxUnits="RelativeToBoundingBox"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center"/>
            </Border.Background>

            <Grid>
                <Border CornerRadius="6" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#E60D1017" Offset="0.0"/>
                            <GradientStop Color="#B8121620" Offset="0.38"/>
                            <GradientStop Color="#75121620" Offset="0.55"/>
                            <GradientStop Color="#D80D1017" Offset="0.82"/>
                            <GradientStop Color="#F20D1017" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <DockPanel LastChildFill="False" Margin="18,14">
                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="SKYRIM AE DIAGNOSTICS &amp; PATCH HUB" FontSize="20" FontWeight="Bold" Foreground="#61AFEF">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding SubtitleText}" FontSize="12" Foreground="#E2E8F0" Margin="0,3,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="130" Margin="0,0,16,0" SelectedIndex="{Binding SelectedLanguageIndex}" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Deutsch (DE)"/>
                            <ComboBoxItem Content="English (EN)"/>
                        </ComboBox>

                        <Button Content="{Binding LaunchBtnText}" Command="{Binding LaunchSkyrimCommand}"
                                Background="#2EA043" BorderBrush="#3FB950" BorderThickness="1.5" Foreground="White" 
                                FontWeight="Bold" Padding="18,9" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="335"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: MODDING TOOL HUB, PATCHER, QUICK FOLDERS & ORIGINAL BLINKING DRAGON EYE -->
            <Border Grid.Column="0" Background="#21252B" CornerRadius="6" Padding="12,10" Margin="0,0,14,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding ToolsHeaderText}" FontSize="14" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,6"/>

                        <Button Content="{Binding BuildPatchBtnText}" Command="{Binding BuildCompatiblePatchCommand}"
                                Background="#3B5998" BorderBrush="#528BFF" FontWeight="SemiBold" Style="{StaticResource ModernButton}"/>

                        <Button Content="{Binding ScanSkseBtnText}" Command="{Binding RunPreFlightScanCommand}" Style="{StaticResource ModernButton}"/>

                        <Button Content="{Binding FixEslBtnText}" Command="{Binding FixEslHeadersCommand}"
                                Background="#5A32A3" BorderBrush="#7C4DFF" FontWeight="SemiBold" Style="{StaticResource ModernButton}"/>

                        <Button Content="{Binding CopyDiscordBtnText}" Command="{Binding CopyDiscordReportCommand}"
                                Background="#2D3B32" BorderBrush="#4B6B53" Style="{StaticResource ModernButton}"/>

                        <Separator Background="#3E4452" Margin="0,5"/>
                        <TextBlock Text="📂 Berichte, Backups &amp; JSONs" FontSize="12.5" FontWeight="SemiBold" Foreground="#61AFEF" Margin="0,0,0,5"/>

                        <Button Content="📂 Ordner 'Berichte' öffnen" Command="{Binding OpenFolderCommand}" CommandParameter="Reports"
                                Background="#1F3A52" BorderBrush="#3B82F6" FontWeight="SemiBold" Style="{StaticResource ModernButton}"/>

                        <Button Content="📦 Ordner 'Backup' öffnen" Command="{Binding OpenFolderCommand}" CommandParameter="Backup"
                                Background="#1F3A52" BorderBrush="#3B82F6" FontWeight="SemiBold" Style="{StaticResource ModernButton}"/>

                        <Button Content="⚙️ Ordner 'Datenbanken' (JSONs)" Command="{Binding OpenFolderCommand}" CommandParameter="Database"
                                Background="#2A2E37" BorderBrush="#E5C07B" Foreground="#E5C07B" FontWeight="SemiBold" Style="{StaticResource ModernButton}"/>

                        <Separator Background="#3E4452" Margin="0,5"/>
                        <TextBlock Text="External Modding Tools" FontSize="12.5" Foreground="#ABB2BF" Margin="0,0,0,5"/>

                        <Button Content="SSEEdit (xEdit)" Command="{Binding LaunchToolCommand}" CommandParameter="SSEEdit" Style="{StaticResource ModernButton}"/>
                        <Button Content="SSEEdit Quick Auto Clean" Command="{Binding LaunchToolCommand}" CommandParameter="SSEEditQuickClean" 
                                Background="#2D3B32" BorderBrush="#4B6B53" Style="{StaticResource ModernButton}"/>
                        <Button Content="Wrye Bash" Command="{Binding LaunchToolCommand}" CommandParameter="WryeBash" Style="{StaticResource ModernButton}"/>
                        <Button Content="LOOT (Load Order)" Command="{Binding LaunchToolCommand}" CommandParameter="LOOT" Style="{StaticResource ModernButton}"/>
                        <Button Content="Synthesis Patcher" Command="{Binding LaunchToolCommand}" CommandParameter="Synthesis" Style="{StaticResource ModernButton}"/>
                        <Button Content="Pandora / Nemesis Engine" Command="{Binding LaunchToolCommand}" CommandParameter="Pandora" Style="{StaticResource ModernButton}"/>
                        <Button Content="BodySlide x64" Command="{Binding LaunchToolCommand}" CommandParameter="BodySlide" Style="{StaticResource ModernButton}"/>
                        <Button Content="BethINI Pie" Command="{Binding LaunchToolCommand}" CommandParameter="BethINI" Style="{StaticResource ModernButton}"/>

                        <Separator Background="#3E4452" Margin="0,5"/>
                        <TextBlock Text="{Binding HotkeyHintText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#98C379" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- UNTERER FREIER PLATZ: Originales 4-Schichten-Drachenauge (Mitte) + Statisches Mini-Auge für Minispiel (Rechts) -->
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,4,0,0">

                        <!-- 1. WIEDERHERGESTELLTES ORIGINALES DRACHENAUGE MIT ECHTEN GESCHUPPTEN AUGENLIDERN -->
                        <Grid Width="138" Height="138" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="EyeBreathingScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <!-- Äußere leuchtende Diagnose-Aura -->
                            <Ellipse Stroke="#3B82F6" StrokeThickness="1.5" Fill="#0A121E">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="EyeAuraGlow" Color="#61AFEF" BlurRadius="16" ShadowDepth="0" Opacity="0.65"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Ebene 1: Äußerer Runenring & Schuppenkranz aus Logo.png (Viewbox="0.295, 0.03, 0.41, 0.61") -->
                            <Ellipse Margin="2" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Logo.png"
                                                Viewbox="0.295, 0.03, 0.41, 0.61"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Ebene 2: Innerer Augapfel mit Binärcode-Pupille (Viewbox="0.398, 0.215, 0.204, 0.305") -->
                            <Grid Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid.Clip>
                                    <EllipseGeometry Center="36,36" RadiusX="35" RadiusY="35"/>
                                </Grid.Clip>

                                <Ellipse RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PupilContractScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="pack://application:,,,/Logo.png"
                                                    Viewbox="0.398, 0.215, 0.204, 0.305"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Ebene 3: Echtes geschupptes Oberlid (staucht/dehnt sich organisch von oben nach unten) -->
                                <Path Data="M -4,0 L 76,0 L 76,37 Q 36,46 -4,37 Z"
                                      VerticalAlignment="Top"
                                      Stroke="#4561AFEF"
                                      StrokeThickness="1"
                                      RenderTransformOrigin="0.5,0.0">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="UpperScalesLidScale" ScaleX="1.0" ScaleY="0.04"/>
                                    </Path.RenderTransform>
                                    <Path.Fill>
                                        <ImageBrush ImageSource="pack://application:,,,/Logo.png"
                                                    Viewbox="0.385, 0.125, 0.23, 0.13"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Stretch="Fill"/>
                                    </Path.Fill>
                                </Path>

                                <!-- Ebene 4: Echtes geschupptes Unterlid (dehnt sich beim Blinzeln synchron von unten nach oben) -->
                                <Path Data="M -4,36 Q 36,27 76,36 L 76,72 L -4,72 Z"
                                      VerticalAlignment="Bottom"
                                      Stroke="#4561AFEF"
                                      StrokeThickness="1"
                                      RenderTransformOrigin="0.5,1.0">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="LowerScalesLidScale" ScaleX="1.0" ScaleY="0.04"/>
                                    </Path.RenderTransform>
                                    <Path.Fill>
                                        <ImageBrush ImageSource="pack://application:,,,/Logo.png"
                                                    Viewbox="0.385, 0.465, 0.23, 0.13"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Stretch="Fill"/>
                                    </Path.Fill>
                                </Path>
                            </Grid>

                            <!-- Dezenter innerer Runen-Glasring zur sauberen Einfassung -->
                            <Ellipse Margin="2" Stroke="#8061AFEF" StrokeThickness="1.2" IsHitTestVisible="False"/>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Sanftes Pulsieren der Aura -->
                                            <DoubleAnimation Storyboard.TargetName="EyeAuraGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="12" To="24" Duration="0:0:3.2"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="EyeAuraGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.45" To="0.85" Duration="0:0:3.2"
                                                             AutoReverse="True"/>

                                            <!-- Sanftes Atmen des gesamten Auges -->
                                            <DoubleAnimation Storyboard.TargetName="EyeBreathingScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.98" To="1.02" Duration="0:0:3.5"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="EyeBreathingScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.98" To="1.02" Duration="0:0:3.5"
                                                             AutoReverse="True"/>

                                            <!-- Organisches Blinzeln des geschuppten Oberlids -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpperScalesLidScale"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           Duration="0:0:9">
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:0.0"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:3.6"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:3.72"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:3.90"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:5.5"/>
                                                <LinearDoubleKeyFrame Value="0.28" KeyTime="0:0:5.8"/>
                                                <LinearDoubleKeyFrame Value="0.28" KeyTime="0:0:6.7"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:7.0"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:7.8"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:7.91"/>
                                                <LinearDoubleKeyFrame Value="0.12" KeyTime="0:0:8.05"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:8.17"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:8.35"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:9.0"/>
                                            </DoubleAnimationUsingKeyFrames>

                                            <!-- Organisches Blinzeln des geschuppten Unterlids -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LowerScalesLidScale"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           Duration="0:0:9">
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:0.0"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:3.6"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:3.72"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:3.90"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:5.5"/>
                                                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:5.8"/>
                                                <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:6.7"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:7.0"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:7.8"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:7.91"/>
                                                <LinearDoubleKeyFrame Value="0.12" KeyTime="0:0:8.05"/>
                                                <LinearDoubleKeyFrame Value="1.02" KeyTime="0:0:8.17"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:8.35"/>
                                                <LinearDoubleKeyFrame Value="0.04" KeyTime="0:0:9.0"/>
                                            </DoubleAnimationUsingKeyFrames>

                                            <!-- Leichte Reaktion der Schlitzpupille beim Blinzeln -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PupilContractScale"
                                                                           Storyboard.TargetProperty="ScaleX"
                                                                           Duration="0:0:9">
                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.0"/>
                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:5.5"/>
                                                <LinearDoubleKeyFrame Value="0.86" KeyTime="0:0:5.8"/>
                                                <LinearDoubleKeyFrame Value="0.86" KeyTime="0:0:6.7"/>
                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:7.0"/>
                                                <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:9.0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>

                        <!-- 2. STATISCHES MINI-AUGE ALS SCHALTFLÄCHE FÜR DAS MINISPIEL (Rechts unten neben dem Hauptauge) -->
                        <Button Click="OpenMiniGame_Click"
                                ToolTip="Skyrim Invaders: CTD Defense (Mini-Game starten)"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="38" Height="38"
                                Margin="0,0,4,4"
                                Style="{StaticResource MiniEyeButton}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- RIGHT: 5 TABS -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- 1. LINKS: ÜBERSICHT -->
                <TabItem DockPanel.Dock="Left" Header="{Binding TabOverviewText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,6,4,4">
                        <StackPanel>
                            <TextBlock Text="{Binding OverviewTitleText}" FontSize="18" FontWeight="Bold" Foreground="#61AFEF" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding OverviewDescText}" TextWrapping="Wrap" Foreground="#DCDFE4" FontSize="13.5" LineHeight="20" Margin="0,0,0,18"/>

                            <UniformGrid Columns="2">
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat1Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat1Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat2Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat2Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat3Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat3Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat4Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat4Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat5Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat5Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat6Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat6Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat7Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat7Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feat8Title}" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Feat8Desc}" TextWrapping="Wrap" Foreground="#ABB2BF" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. LINKS: DIAGNOSE & LÖSUNGEN -->
                <TabItem DockPanel.Dock="Left" Header="{Binding TabDiagnosticsText}">
                    <DockPanel Margin="4,6,4,4">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ReportHeaderText}" FontSize="16" FontWeight="Bold" Foreground="#61AFEF" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="📦 Ordner 'Backup'" Command="{Binding OpenFolderCommand}" CommandParameter="Backup"
                                    Background="#2A2E37" Foreground="White" Padding="10,4" Margin="8,0,0,0" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Content="📂 Ordner 'Berichte'" Command="{Binding OpenFolderCommand}" CommandParameter="Reports"
                                    Background="#1F3A52" BorderBrush="#3B82F6" Foreground="White" Padding="10,4" Cursor="Hand"/>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" Background="#181A1F" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ReportProgressLabelText}" FontWeight="SemiBold" Foreground="#E5C07B" FontSize="12.5"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ReportProgressValue, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="#61AFEF" FontSize="12.5"/>
                                </DockPanel>
                                <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding ReportProgressValue}" 
                                             Background="#282C34" Foreground="#2EA043" BorderBrush="#3E4452" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding ReportProgressStatusText}" TextWrapping="Wrap" Foreground="#98C379" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding ReportSummary}" TextWrapping="Wrap" Foreground="#DCDFE4" Margin="0,0,0,14"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DetectedIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding IssueType}" FontWeight="Bold" FontSize="15" Foreground="#E06C75"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding AffectedFormId, StringFormat='  |  FormID: {0}'}" Foreground="#D19A66" FontWeight="SemiBold"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CausingPlugin}" Foreground="#61AFEF" FontWeight="SemiBold"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#ABB2BF" Margin="0,0,0,10"/>

                                                <ItemsControl ItemsSource="{Binding StepByStepSolution}" Margin="8,0,0,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="#98C379" Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Auto-Fix in AutoDiagPatch.esp (Mutagen)"
                                                            Visibility="{Binding CanAutoPatchWithMutagen, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.BuildCompatiblePatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Background="#2EA043" Foreground="White" Padding="10,5" Margin="0,0,10,0" Cursor="Hand"/>

                                                    <Button Content="In SSEEdit prüfen"
                                                            Command="{Binding DataContext.OpenInSseEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding CausingPlugin}"
                                                            Background="#3B5998" Foreground="White" Padding="10,5" Margin="0,0,10,0" Cursor="Hand"/>

                                                    <Button Content="📘 Tool-Workflow (HTML) öffnen"
                                                            Command="{Binding DataContext.OpenWorkflowGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#D97706" Foreground="White" FontWeight="SemiBold" Padding="10,5" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- 3. LINKS: KONFIGURATION & PFADE -->
                <TabItem DockPanel.Dock="Left" Header="{Binding TabSettingsText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,6,4,4">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding SettingsHeaderText}" FontSize="16" FontWeight="Bold" Foreground="#E5C07B" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="{Binding AutoDetectBtnText}" Command="{Binding AutoDetectPathsCommand}"
                                        Background="#2EA043" BorderBrush="#3FB950" Foreground="White" FontWeight="SemiBold" Padding="14,6" Cursor="Hand"/>
                            </DockPanel>

                            <CheckBox Content="{Binding OfflineModeChkText}" IsChecked="{Binding UseOfflineModeOnly}" Foreground="#98C379" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="{Binding SpidExportChkText}" IsChecked="{Binding GenerateSpidIni}" Foreground="#61AFEF" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <TextBlock Text="Gemini API Key (Optional):" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="🔑 API Key erstellen (Google AI Studio)" Command="{Binding OpenApiKeyPageCommand}"
                                        Background="#2A2E37" BorderBrush="#E5C07B" Foreground="#E5C07B" FontWeight="SemiBold"
                                        Padding="12,6" Margin="8,0,0,0" Cursor="Hand"/>
                                <Button DockPanel.Dock="Right" Content="{Binding TestApiBtnText}" Command="{Binding TestGeminiApiCommand}"
                                        Background="#3B5998" BorderBrush="#528BFF" Foreground="White" FontWeight="SemiBold"
                                        Padding="14,6" Margin="8,0,0,0" Cursor="Hand"/>
                                <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="{Binding ModelSelectLabelText}" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableGeminiModels}"
                                      SelectedItem="{Binding SelectedGeminiModel, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="8,6" Margin="0,0,0,12" HorizontalAlignment="Left" Width="340"/>

                            <TextBlock Text="In-Game Screenshot Hotkey (Klicken &amp; Taste drücken / Click &amp; press key):" Foreground="#61AFEF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ScreenshotHotkey, Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     Background="#1E2430" Foreground="#98C379" FontWeight="Bold" BorderBrush="#61AFEF" BorderThickness="1.5"
                                     Padding="8,6" Width="220" HorizontalAlignment="Left" TextAlignment="Center" Cursor="Hand" Margin="0,0,0,14"/>

                            <TextBlock Text="Skyrim AE Hauptverzeichnis (Root Folder):" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="SkyrimRoot" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding SkyrimRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="SSEEdit.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="SSEEdit" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding SseEditExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="SSEEditQAC.exe (Quick Auto Clean):" Foreground="#98C379" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="SSEEditQuickClean" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding SseEditQuickCleanExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="Wrye Bash.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="WryeBash" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding WryeBashExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="LOOT.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="LOOT" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding LootExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="Synthesis.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="Synthesis" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding SynthesisExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="Pandora / Nemesis Engine (.exe):" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="Pandora" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding PandoraExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="BodySlide x64.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="BodySlide" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding BodySlideExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <TextBlock Text="BethINI.exe:" Foreground="#ABB2BF" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,18">
                                <Button DockPanel.Dock="Right" Content="..." Width="45" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}" CommandParameter="BethINI" Style="{StaticResource ModernButton}"/>
                                <TextBox Text="{Binding BethIniExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                            </DockPanel>

                            <Button Content="{Binding SaveConfigBtnText}" Command="{Binding SaveConfigCommand}"
                                    Background="#2EA043" BorderBrush="#3FB950" Foreground="White" 
                                    FontWeight="Bold" Padding="16,10" HorizontalAlignment="Left" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4. GANZ RECHTS AM FENSTERRAND (Farblich in Gold abgesetzt): BENUTZERHANDBUCH -->
                <TabItem DockPanel.Dock="Right" Header="{Binding TabManualText}"
                         Foreground="#E5C07B" Background="#262118" BorderBrush="#D97706" FontWeight="Bold" Margin="0">
                    <DockPanel Margin="4,6,4,4">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ManualHeaderText}" FontSize="17" FontWeight="Bold" Foreground="#61AFEF" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="{Binding ManualCollapseAllBtnText}" Command="{Binding CollapseAllManualCommand}"
                                    Background="#2A2E37" Foreground="White" Padding="10,5" Margin="6,0,0,0" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Content="{Binding ManualExpandAllBtnText}" Command="{Binding ExpandAllManualCommand}"
                                    Background="#3B5998" Foreground="White" Padding="10,5" Cursor="Hand"/>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="{Binding ManualResetSearchBtnText}" Command="{Binding ResetManualSearchCommand}"
                                    Background="#2A2E37" Foreground="#E5C07B" Padding="12,6" Margin="8,0,0,0" Cursor="Hand"/>
                            <TextBox Text="{Binding ManualSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredManualSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Foreground="#E6E6E6">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#3B5998" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding CategoryBadge}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="#E5C07B"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="8,10,4,4">
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#61AFEF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding Steps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#1E222A" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,8">
                                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#DCDFE4" LineHeight="20"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Background="#1B2A20" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding ProTip}" TextWrapping="Wrap" Foreground="#98C379" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- 5. DIREKT LINKS VOR DEM HANDBUCH (Farblich in Grün abgesetzt): ONLINE-LÖSUNGSSUCHE -->
                <TabItem DockPanel.Dock="Right" Header="{Binding TabWebSearchText}"
                         Foreground="#98C379" Background="#19261E" BorderBrush="#2EA043" FontWeight="Bold" Margin="0,0,6,0">
                    <DockPanel Margin="4,6,4,4">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding WebSearchHeaderText}" FontSize="17" FontWeight="Bold" Foreground="#61AFEF" Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding WebSearchDescText}" TextWrapping="Wrap" Foreground="#ABB2BF" Margin="0,0,0,12"/>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{Binding WebSearchSaveHtmlBtnText}" Command="{Binding SaveWebSearchHtmlCommand}"
                                    Background="#3B5998" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="8,0,0,0" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Content="{Binding WebSearchBtnText}" Command="{Binding ExecuteWebSearchCommand}"
                                    Background="#2EA043" Foreground="White" FontWeight="SemiBold" Padding="14,7" Margin="8,0,0,0" Cursor="Hand"/>
                            <TextBox Text="{Binding WebSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding WebSearchStatusText}" Foreground="#98C379" Margin="0,0,0,10"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WebSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#282C34" BorderBrush="#3E4452" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Left" Background="#5A32A3" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SourceBadge}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" Foreground="#E5C07B" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="#DCDFE4" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding RecommendedSteps}" Margin="8,0,0,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="#98C379" Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding DataContext.WebSearchOpenUrlBtnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.OpenWebUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding ThreadUrl}"
                                                        HorizontalAlignment="Left" Background="#2A2E37" BorderBrush="#61AFEF" Foreground="#61AFEF" Padding="10,4" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#21252B" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding CurrentStatusText}" Foreground="#ABB2BF" FontSize="12"/>
        </Border>
    </Grid>
</Window>